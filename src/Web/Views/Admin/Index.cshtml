@model AdminIndex

@{
    ViewData["Title"] = "Admin Page";
}

<h1>Admin area</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Staff[0].FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Staff[0].LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Staff[0].Email)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var staff in Model.Staff)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => staff.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(model => staff.LastName)
                </td>
                <td>
                    @Html.DisplayFor(model => staff.Email)
                    <td class="text-end">
                        <button type="button" class="btn btn-outline-primary"
                                onclick="loadModal('Admin', 'Update', '@staff.Id')" aria-label="Edit game">
                            <i class="bi bi-pencil-square" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="btn btn-outline-primary"
                                onclick="loadModal('Admin', 'Delete', '@staff.Id')" aria-label="Delete game">
                            <i class="bi bi-trash3" aria-hidden="true"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>