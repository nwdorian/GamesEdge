@using Infrastructure.Users
@using Microsoft.AspNetCore.Identity
@using Web.Models.Users.Extensions

@inject SignInManager<User> SignInManager

<div class="d-flex justify-content-center">
    <section>
        <p>Or login with:</p>
        @{
            var providers = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToList();
            if (!providers.Any())
            {
                <div>
                    <p>We couldn't find any external provider</p>
                </div>
            }
            else
            {
                <form asp-action="ExternalLogin" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post"
                      class="form-horizontal">
                    <div class="d-grid gap-2">
                        @foreach (var provider in providers)
                        {
                            <button type="submit" name="provider" value="@provider.Name" class="btn btn-outline-secondary w-100">
                                <i class="bi @provider.BootstrapIcon()" aria-hidden="true"></i>
                                <span>@provider.Name</span>
                            </button>
                        }
                    </div>
                </form>
            }
        }
    </section>
</div>